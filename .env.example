# Values for C:\GlobeGuard\docker-compose.yml (the full stack). Copy to .env - never commit .env.
# Every variable has a default in the compose file except the four secrets at the top.
# The complete backend variable inventory is globeguard-backend/.env.example, the frontend's is
# globeguard-frontend/.env.example; the beta host template is globeguard-backend/deploy/backend.env.example.

# --- Secrets (required) --------------------------------------------------------
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=<generate: openssl rand -hex 9>
COOKIE_SECRET=<generate: openssl rand -hex 24>
# Frontend /api/revalidate secret.
REVALIDATION_SECRET=<generate: openssl rand -base64 32>

# --- First boot ---------------------------------------------------------------
# true ONLY while the server service boots alone on an empty database (seeds the catalog,
# see the recipe in docker-compose.yml). Set back to false right after "Catalog seed finished":
# true re-upserts from data/* on every boot and overwrites dashboard product edits.
SEED_CATALOG=true

# --- Backend behaviour ----------------------------------------------------------
# production disables the /mailbox dev mailbox and, without SENDGRID_API_KEY, discards every
# e-mail. Use development for local registration / verification-link tests.
APP_ENV=production
# true boots without RedisCachePlugin (the redis container is then unused).
REDIS_DISABLED=false

# --- Public origins (browser-reachable) ------------------------------------------
# Storefront origin: baked into the frontend image (NEXT_PUBLIC_SITE_URL, needs a rebuild when
# changed) and used by the backend for e-mail links / Mollie fallback redirect. A hostname
# containing "beta." makes the storefront's robots.txt disallow everything.
PUBLIC_SITE_URL=http://localhost:3100
# Backend origin. Mollie POSTs webhooks to <VENDURE_HOST>/payments/mollie/...; for an
# end-to-end payment test expose :3000 through a tunnel and put that URL here.
VENDURE_HOST=http://localhost:3000
# The storefront serves /assets itself and rewrites them to the server container, so this is the
# STOREFRONT origin, not the backend one. That is the only value that works both in the browser
# and inside the frontend container, where next/image fetches it server-side.
ASSET_URL_PREFIX=http://localhost:3100/assets/
NEXT_PUBLIC_SITE_NAME=GlobeGuard
# Hostname (no protocol/path) serving Vendure assets over https, added to next/image
# remotePatterns. Empty for the localhost stack.
NEXT_PUBLIC_ASSET_HOST=
VENDURE_CHANNEL_TOKEN=__default_channel__

# --- Optional integrations --------------------------------------------------------
# test_... / live_... key. Empty = "Online bezahlen" is not provisioned (invoice only).
MOLLIE_API_KEY=
# Empty = e-mails are discarded under APP_ENV=production (dev mailbox under development).
SENDGRID_API_KEY=
SUPPORT_EMAIL=info@globeguard.ch
